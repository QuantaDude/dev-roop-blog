:root{--bg_h:#282828;--bg:#282828;--bg_s:#3c3836;--bg1:#3c3836;--bg2:#504945;--bg3:#665c54;--bg4:#7c6f64;--fg:#ebdbb2;--fg1:#ebdbb2;--fg2:#d5c4a1;--fg3:#bdae93;--fg4:#a89984;--orange:#fe8019;--orange-dim:#d65d0e;--link-color:var(--orange);--link-hover-color:var(--orange-dim);--border-color:#504945;--secondary-text-color:#bdae93;--code-bg-color:#3c3836}main.resume{background:var(--bg);color:var(--fg);max-width:100%!important}main.resume article{max-width:800px;margin:0 auto;padding:2rem 1.5rem}main.resume article header{text-align:center;border-bottom:2px solid var(--fg4);margin-bottom:1.5rem;padding-bottom:1rem}main.resume article header h1{font-size:2.4rem;margin-bottom:.4rem;color:var(--fg)}main.resume article header .subtitle{color:var(--secondary-text-color);font-size:1.15rem}main.resume article header .contact-info p{margin:.3rem 0}main.resume article header time{display:none}main.resume article .content{line-height:1.75}main.resume article .content h2{margin-top:2rem;border-bottom:1px solid var(--border-color);padding-bottom:.4rem;font-size:1.7rem}main.resume article .content h3{font-size:1.3rem;margin-top:1.2rem}main.resume article .content p,main.resume article .content li{text-align:justify;hyphens:auto}main.resume article .content ul,main.resume article .content ol{margin-left:1.4rem}main.resume article .content strong{color:var(--fg)}main.resume article .content{}main.resume article .content a,main.resume article .content a:visited,main.resume article .content a:hover,main.resume article .content a:active{color:var(--orange);text-decoration:underline;border:none}main.resume article .content code{background:var(--code-bg-color);padding:.15rem .35rem;border-radius:3px}main.resume article .content blockquote{border-left:3px solid var(--orange);padding-left:1rem;color:var(--secondary-text-color);font-style:italic}main.resume article .resume-download{display:none}@page{size:A4;margin:14mm}@media print{body{background:var(--bg)!important;color:var(--fg)!important}main.resume{box-shadow:none}}